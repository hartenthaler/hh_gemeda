<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Individual;
use Hartenthaler\Webtrees\Module\GeMeDaModule\Domain\GeMeDaSearchCriteria;
use Hartenthaler\Webtrees\Module\GeMeDaModule\Domain\GeMeDaSearchResult;

/** @var string $title */
/** @var Individual $individual */
/** @var GeMeDaSearchCriteria $criteria */
/** @var list<GeMeDaSearchResult> $results */
/** @var ?string $error */
/** @var bool $can_edit */
/** @var string $search_url */
/** @var bool $searched */
?>

<h1><?= e($title) ?></h1>
<p><a href="<?= e($individual->url()) ?>"><?= e(strip_tags($individual->fullName())) ?></a></p>

<?php if ($error !== null) : ?>
    <div class="alert alert-warning"><?= e($error) ?></div>
<?php endif ?>

<form method="post" action="<?= e($search_url) ?>" class="mb-4">
    <?= csrf_field() ?>
    <input type="hidden" name="operation" value="search">
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label" for="gemeda-given-name"><?= I18N::translate('Given name') ?></label>
            <input class="form-control" id="gemeda-given-name" name="given_name" value="<?= e($criteria->givenName) ?>">
        </div>
        <div class="col-md-3">
            <label class="form-label" for="gemeda-surname"><?= I18N::translate('Surname') ?></label>
            <input class="form-control" id="gemeda-surname" name="surname" value="<?= e($criteria->surname) ?>">
        </div>
        <div class="col-md-6">
            <label class="form-label" for="gemeda-place"><?= I18N::translate('Place') ?></label>
            <input class="form-control" id="gemeda-place" name="place" value="<?= e($criteria->place) ?>">
        </div>
    </div>
    <button class="btn btn-primary mt-3" type="submit"><?= I18N::translate('Search') ?></button>
</form>

<?php if (!$searched) : ?>
    <p class="text-muted"><?= I18N::translate('Adjust the fields if necessary, then start the search.') ?></p>
<?php elseif ($results === []) : ?>
    <p><?= I18N::translate('No GeMeDa persons were found.') ?></p>
<?php else : ?>
    <table class="table table-sm table-striped">
        <thead>
        <tr>
            <th><?= I18N::translate('Name') ?></th>
            <th><?= I18N::translate('GeMeDa identifier') ?></th>
            <th><?= I18N::translate('Linked sources') ?></th>
            <th><?= I18N::translate('Action') ?></th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($results as $result) : ?>
            <tr>
                <td><?= e($result->displayName) ?></td>
                <td><code><?= e($result->personHash) ?></code></td>
                <td>
                    <?php foreach ($result->sources as $source) : ?>
                        <div><?= e($source['label'] ?? $source['provider']) ?>: <code><?= e($source['external_id']) ?></code></div>
                    <?php endforeach ?>
                </td>
                <td>
                    <?php if ($can_edit) : ?>
                        <form method="post" action="<?= e($search_url) ?>">
                            <?= csrf_field() ?>
                            <input type="hidden" name="operation" value="assign">
                            <input type="hidden" name="person_hash" value="<?= e($result->personHash) ?>">
                            <input type="hidden" name="person_name" value="<?= e($result->displayName) ?>">
                            <button class="btn btn-sm btn-primary" type="submit">
                                <?= I18N::translate('Add EXID') ?>
                            </button>
                        </form>
                    <?php endif ?>
                </td>
            </tr>
        <?php endforeach ?>
        </tbody>
    </table>
<?php endif ?>
